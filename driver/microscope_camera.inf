; microscope_camera.inf -- binds the HDCE-10A microscope camera (eMPIA EM2750, USB 1578:800C)
; to the libusb-win32 kernel driver, so the Microscope Camera app can drive it from user space.
; Based on the libusb-win32 / libwdi device INF. libusb-win32 is (c) libusb-win32 contributors (GNU LGPL/GPL).
[Strings]
DeviceName = "HDCE-10A Microscope Camera"
VendorName = "Huaqi Digital"
SourceName = "Microscope Camera Driver"
DeviceID   = "VID_1578&PID_800C"
DeviceGUID = "{5FEB3A94-80A3-45AC-8CAC-8F216A7F9F6C}"

[Version]
Signature   = "$Windows NT$"
Class       = "libusb-win32 devices"
ClassGuid   = {EB781AAF-9C70-4523-A5DF-642A87ECA567}
Provider    = "Microscope Camera"
CatalogFile = microscope_camera.cat
DriverVer   = 10/20/2026, 1.4.0.1

[ClassInstall32]
Addreg = libusb_class_install_add_reg

[libusb_class_install_add_reg]
HKR,,,0,"libusb-win32 devices"
HKR,,Icon,,-20

[Manufacturer]
%VendorName% = Devices, NTAMD64

[SourceDisksNames]
1 = %SourceName%

[SourceDisksFiles.amd64]
libusb0.sys     = 1,amd64
libusb0.dll     = 1,amd64
libusb0_x86.dll = 1,x86

[DestinationDirs]
libusb_files_sys       = 10,system32\drivers
libusb_files_dll       = 10,system32
libusb_files_dll_wow64 = 10,syswow64

[libusb_files_sys]
libusb0.sys

[libusb_files_dll]
libusb0.dll

[libusb_files_dll_wow64]
libusb0.dll, libusb0_x86.dll

[LIBUSB_WIN32_DEV.NTAMD64]
CopyFiles = libusb_files_sys, libusb_files_dll, libusb_files_dll_wow64

[LIBUSB_WIN32_DEV.NTAMD64.HW]
DelReg = libusb_del_reg_hw
AddReg = libusb_add_reg_hw

[LIBUSB_WIN32_DEV.NTAMD64.Services]
AddService = libusb0, 0x00000002, libusb_add_service

; The vendor's XP driver installed filter drivers; make sure none are left behind.
[libusb_del_reg_hw]
HKR,,LowerFilters
HKR,,UpperFilters

[libusb_add_reg_hw]
HKR,,SurpriseRemovalOK,0x00010001,1
HKR,,DeviceInterfaceGUIDs,0x00010000,%DeviceGUID%

[libusb_add_service]
DisplayName   = "libusb-win32 - Kernel Driver 02/22/2024 1.4.0.0"
ServiceType   = 1
StartType     = 3
ErrorControl  = 0
ServiceBinary = %12%\libusb0.sys

[Devices.NTAMD64]
%DeviceName% = LIBUSB_WIN32_DEV.NTAMD64, USB\%DeviceID%
